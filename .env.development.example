# SeaTrack development environment template
MAIL_API_PORT=8787
MAIL_API_ORIGIN=http://localhost:5173
MAIL_PROVIDER=resend
MAIL_FROM=SeaTrack <noreply@example.com>
RESEND_API_KEY=
MAIL_RETRY_ATTEMPTS=3

AUTH_REQUIRED=false
AUTH_JWT_SECRET=change-this-dev-secret
AUTH_TOKEN_TTL_HOURS=12
AUTH_TEMP_PASSWORD=SeaTrack1!

TRACKING_SOURCE=cma
TRACKING_LOG_PATH=./logs/tracking-sync.ndjson
TRACKING_MOCK_PATH=./logs/tracking-mock.json

# Maersk (production endpoints recommended)
MAERSK_CONSUMER_KEY=
MAERSK_CONSUMER_SECRET=
MAERSK_OAUTH_TOKEN_URL=https://api.maersk.com/oauth2/access_token
MAERSK_TRACKING_BASE_URL=https://api.maersk.com/track-and-trace-private
MAERSK_API_VERSION=1
MAERSK_EVENTS_LIMIT=100
MAERSK_HTTP_TIMEOUT_MS=15000

# CMA
CMA_API_KEY=
CMA_TRACKING_BASE_URL=https://apis.cma-cgm.net
CMA_TRACKING_PATH=/operation/trackandtrace/v1
CMA_API_VERSION=2.2.0
CMA_EVENTS_LIMIT=100
CMA_HTTP_TIMEOUT_MS=15000
