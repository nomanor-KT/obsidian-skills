{
  "name": "seatrackv3-runner",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "concurrently --kill-others --names \"vite,api\" --prefix-colors \"cyan,yellow\" \"vite\" \"node server/index.js\"",
    "build": "vite build",
    "lint": "eslint .",
    "test:tracking": "node scripts/test-tracking-sync.mjs",
    "test:status-rules": "node scripts/test-tracking-status-rules.mjs",
    "preview": "vite preview",
    "dev:local": "vite --host 0.0.0.0 --port 5173",
    "server": "node server/index.js",
    "dev:api": "node server/index.js"
  },
  "dependencies": {
    "react": "^19.1.1",
    "react-dom": "^19.1.1",
    "xlsx": "^0.18.5"
  },
  "devDependencies": {
    "@eslint/js": "^9.33.0",
    "@types/react": "^19.1.10",
    "@types/react-dom": "^19.1.7",
    "@vitejs/plugin-react": "^5.0.0",
    "concurrently": "^9.2.1",
    "eslint": "^9.33.0",
    "eslint-plugin-react-hooks": "^5.2.0",
    "eslint-plugin-react-refresh": "^0.4.20",
    "globals": "^16.3.0",
    "vite": "^7.1.2"
  }
}
