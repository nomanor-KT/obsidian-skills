# Mail API server
MAIL_API_PORT=8787
MAIL_API_ORIGIN=http://localhost:5173
MAIL_PROVIDER=resend
MAIL_FROM=SeaTrack <noreply@twojadomena.pl>
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxx
MAIL_RETRY_ATTEMPTS=3
# Optional custom path relative to server/
# MAIL_LOG_PATH=./logs/email-log.ndjson

# Authentication
# Keep false until frontend login flow is wired.
AUTH_REQUIRED=false
# Replace in production / firmowy serwer.
AUTH_JWT_SECRET=change-this-secret
AUTH_TOKEN_TTL_HOURS=12
AUTH_TEMP_PASSWORD=SeaTrack1!
# Optional custom paths relative to server/
# AUTH_LOG_PATH=./logs/auth-log.ndjson
# USERS_PATH=./data/users.json

# Tracking sync (MVP)
# Source mode for tracking endpoint: mock | maersk
TRACKING_SOURCE=mock
# Optional custom paths relative to server/
# TRACKING_LOG_PATH=./logs/tracking-sync.ndjson
# TRACKING_MOCK_PATH=./logs/tracking-mock.json

# Maersk adapter (required when TRACKING_SOURCE=maersk)
# MAERSK_CONSUMER_KEY=
# MAERSK_CONSUMER_SECRET=
# MAERSK_OAUTH_TOKEN_URL=https://api-stage.maersk.com/oauth2/access_token
# MAERSK_TRACKING_BASE_URL=https://api-stage.maersk.com/track-and-trace-private
# MAERSK_API_VERSION=1
# MAERSK_EVENTS_LIMIT=100
# MAERSK_HTTP_TIMEOUT_MS=15000

# CMA CGM Track & Trace API
# CMA_API_KEY=<api key>
# CMA_TRACKING_BASE_URL=https://apis.cma-cgm.net
# CMA_TRACKING_PATH=/operation/trackandtrace/v1
# CMA_API_VERSION=2.2.0
# CMA_EVENTS_LIMIT=100
# CMA_HTTP_TIMEOUT_MS=15000
